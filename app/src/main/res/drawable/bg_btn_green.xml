<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#2E9E22" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#4CDB3C" android:endColor="#2E9E22" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
