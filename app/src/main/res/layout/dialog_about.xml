<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/about_dev"
            android:textColor="@color/green"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/about_desc"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/aSite"
            style="@style/ActionBtn"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_green"
            android:text="@string/about_site"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aTelegram"
            style="@style/ActionBtn"
            android:background="@drawable/bg_btn_blue"
            android:text="@string/about_telegram" />

        <TextView
            android:id="@+id/aTiktok"
            style="@style/ActionBtn"
            android:text="@string/about_tiktok" />

        <TextView
            android:id="@+id/aShareSelf"
            style="@style/ActionBtn"
            android:background="@drawable/bg_btn_purple"
            android:text="@string/about_share_self" />
    </LinearLayout>
</ScrollView>
